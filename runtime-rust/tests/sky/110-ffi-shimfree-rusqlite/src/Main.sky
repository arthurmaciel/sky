module Main exposing (main)

-- Shim-free proof: rusqlite (a real SQLite client SDK) bound DIRECTLY by auto-FFI
-- (no wrapper). Reads the linked SQLite library version number — proving the crate
-- links + a foreign call is callable from Sky with no shim. (rusqlite's Connection
-- handle is RefCell-based / !Send, a separate limitation — tracked in #107.)
import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Error as Error
import Rust.Rusqlite as Sqlite
import Std.Log exposing (println)


check : Task Error ()
check =
    case Sqlite.version_number () of

        Ok n ->
            if n > 3000000 then
                Task.succeed ()

            else
                Task.fail
                    (Error.unexpected
                        ("rusqlite version_number=UNEXPECTED "
                            ++ String.fromInt n))

        Err e ->
            Task.fail e


main : Task Error ()
main =
    check |> Task.andThen (\_ -> println "[ALL OK]")
