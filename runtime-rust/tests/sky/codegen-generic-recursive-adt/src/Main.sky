module Main exposing (main)
import Sky.Core.Prelude exposing (..)
import Std.Log exposing (println)

type Tree a = Leaf | Node a (Tree a)

depth : Tree a -> Int
depth t =
    case t of
        Leaf -> 0
        Node _ rest -> 1 + depth rest

main =
    let t = Node 1 (Node 2 (Node 3 Leaf))
    in println (String.fromInt (depth t))
