module Main exposing (main)

-- 83-ffi-mixed-generic-turbofish: Sky WALL 4 stretch (#72) — a method with TWO
-- generics, EACH reduced by a DIFFERENT mechanism, so the method-level turbofish
-- must name a concrete per generic in DECLARATION ORDER.
--
-- The firestore `get_obj` keystone:
--   get_obj<T: DeserializeOwned + Send, S: AsRef<str> + Send>(&self, id: S)
--       -> Result<T, String>
--   T → serde_json::Value (WALL-3a #59 serde reduction)
--   S → String            (WALL-2  #58 AsRef mono)
-- BOTH leave the Sky-visible generic `order` EMPTY, so the path `type_args` is
-- empty. The Rust method STILL declares `<T, S>` → the method-level turbofish
-- must be `::<serde_json::Value, String>`. Pre-#72: a single
-- `::<serde_json::Value>` → E0107 (method takes 2 generics, 1 supplied).
--
-- POSITIVE (bind + run end-to-end as Task; the get_obj wrapper cargo-COMPILES):
--   Db.new ()                    inherent ctor → opaque Db
--   get_obj db "id1"             async-trait get_obj → Task Error String (JSON)
--   get_obj_sync db "id2"        SYNC inherent control (same two-mechanism mix)
--   pick db "k" payload          THREE-generic control → ::<Value, String, Value>

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Error as Error
import Sky.Core.Json.Encode as Encode
import Sky.Core.Json.Decode as Decode
import Rust.Mixedgenericcrate83 as Repo
import Std.Log exposing (println)


-- The Serialize payload `pick` takes (a Sky JSON String → &Value at the boundary).
payload : String
payload =
    Encode.encode 0
        (Encode.object
            [ ( "name", Encode.string "sky" )
            , ( "version", Encode.int 83 )
            ]
        )


-- Decode the JSON String the host returns and read back its `id` field. The host
-- builds `{"id":"<the-id>"}`, so the decoded id must equal the id we passed.
decodeId : String -> Result Error String
decodeId json =
    case Decode.decodeString (Decode.field "id" Decode.string) json of
        Ok s ->
            Ok s

        Err _ ->
            Err (Error.unexpected ("could not decode id from: " ++ json))


-- POSITIVE: the mixed-generic turbofish round-trip.
--   get_obj      : Db -> String -> Task Error String  (#[async_trait] + T→Value + S→String)
--   get_obj_sync : Db -> String -> Task Error String  (SYNC inherent control)
--   pick         : Db -> String -> String -> Task Error String  (3-generic control)
checkRoundTrip : Task Error ()
checkRoundTrip =
    case Repo.new_from_db () of
        Err _ ->
            Task.fail (Error.unexpected "Db.new failed")

        Ok db ->
            Repo.get_obj_from_db db "id1"
                |> Task.andThen
                    (\json1 ->
                        case decodeId json1 of
                            Err e ->
                                Task.fail e

                            Ok id1 ->
                                if id1 == "id1" then
                                    -- get_obj_sync_from_db / pick_from_db are SYNC
                                    -- (Result String String); the host err slot is
                                    -- unreadable (skyi vs codegen), so map to Error.
                                    case Repo.get_obj_sync_from_db db "id2" of
                                        Err _ ->
                                            Task.fail (Error.unexpected "get_obj_sync failed")

                                        Ok json2 ->
                                            case decodeId json2 of
                                                Err e2 ->
                                                    Task.fail e2

                                                Ok id2 ->
                                                    if id2 == "id2" then
                                                        -- pick_from_db is async (Task) → 3-generic turbofish control.
                                                        Repo.pick_from_db db "k" payload
                                                            |> Task.andThen
                                                                (\_ ->
                                                                    println "[ALL OK]"
                                                                )

                                                    else
                                                        Task.fail (Error.unexpected ("get_obj_sync UNEXPECTED id: " ++ id2))

                                else
                                    Task.fail (Error.unexpected ("get_obj UNEXPECTED id: " ++ id1))
                    )


main : Task Error ()
main =
    checkRoundTrip
