module Main exposing (main)

-- 75-ffi-nested-glob-asref: WALL 1 + WALL 2 proof fixture.
--
-- WALL 1 target: Sup/Doc reachable ONLY through two levels of private modules:
--   crate root → mod inner (private) + pub use inner::* →
--   inner/mod.rs → mod deep (private) + pub use deep::* →
--   inner/deep.rs → pub struct Sup / pub trait Op / pub struct Doc
--
-- WALL 2 — POSITIVE-INHERENT: Sup::op<S: AsRef<str>+Send> → String
--   Inherent method, A-path (resolve_generics).
--
-- WALL 2 — POSITIVE-TRAIT: Doc::op_trait<S: AsRef<str>+Send> → String
--   Trait method (concrete Self), B-path (try_parametric_stub mono pre-pass).
--
-- Control (one level, already works pre-fix):
--   Inner lives in inner/mod.rs directly (one private level glob)
--
-- Collision (C2): Dual is in both nested_glob_crate::vis::Dual AND
--   nested_glob_crate::Dual (via pub use vis::*); insert_shorter picks shorter.
--
-- Negatives: op_neg (AsRef+Serialize) and op_ambig (AsRef<str>+AsRef<[u8]>)
--   must be ABSENT from bindings (dropped at FFI-inspector layer).
--   op_ambig uses AsRef<[u8]> (→ Vec<u8>) to create a genuine conflict with
--   AsRef<str> (→ String); resolve_param_bounds returns None on the conflict.

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Error as Error
import Rust.Nested_glob_crate as G
import Std.Log exposing (println)


checkInner : Task Error ()
checkInner =
    case G.new_from_inner 5 of
        Ok inner ->
            case G.get_x_from_inner inner of
                Ok x ->
                    if x == 5 then
                        println "inner=5"

                    else
                        Task.fail (Error.unexpected ("inner=UNEXPECTED " ++ String.fromInt x))

                Err e ->
                    Task.fail e

        Err e ->
            Task.fail e


checkSup : Task Error ()
checkSup =
    case G.new_from_sup 42 of
        Ok sup ->
            case G.get_y_from_sup sup of
                Ok y ->
                    if y == 42 then
                        println "sup=42"

                    else
                        Task.fail (Error.unexpected ("sup=UNEXPECTED " ++ String.fromInt y))

                Err e ->
                    Task.fail e

        Err e ->
            Task.fail e


checkDual : Task Error ()
checkDual =
    case G.new_from_dual 7 of
        Ok dual ->
            case G.get_d_from_dual dual of
                Ok d ->
                    if d == 7 then
                        println "dual=7"

                    else
                        Task.fail (Error.unexpected ("dual=UNEXPECTED " ++ String.fromInt d))

                Err e ->
                    Task.fail e

        Err e ->
            Task.fail e


-- WALL 2: POSITIVE-INHERENT — Sup::op (A-path / resolve_generics)
checkOpInherent : Task Error ()
checkOpInherent =
    case G.new_from_sup 42 of
        Ok sup ->
            case G.op_from_sup sup "!" of
                Ok s ->
                    if s == "42!" then
                        println "op_inherent=42!"

                    else
                        Task.fail (Error.unexpected ("op_inherent=UNEXPECTED " ++ s))

                Err e ->
                    Task.fail e

        Err e ->
            Task.fail e


-- WALL 2: POSITIVE-TRAIT — Doc::op_trait (B-path / try_parametric_stub mono pre-pass)
checkOpTrait : Task Error ()
checkOpTrait =
    case G.new_from_doc 42 of
        Ok doc ->
            case G.op_trait_from_doc doc "!" of
                Ok s ->
                    if s == "42!" then
                        println "op_trait=42!"

                    else
                        Task.fail (Error.unexpected ("op_trait=UNEXPECTED " ++ s))

                Err e ->
                    Task.fail e

        Err e ->
            Task.fail e


main : Task Error ()
main =
    checkInner
        |> Task.andThen (\_ -> checkSup)
        |> Task.andThen (\_ -> checkDual)
        |> Task.andThen (\_ -> checkOpInherent)
        |> Task.andThen (\_ -> checkOpTrait)
        |> Task.andThen (\_ -> println "[ALL OK]")
