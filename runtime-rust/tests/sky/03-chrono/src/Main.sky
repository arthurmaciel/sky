module Main exposing (main)

-- Date/time via chrono — fully automatic FFI, no shims needed.
-- All bindings are discovered by `cargo +nightly rustdoc --output-format json`.
--
-- Run:  sky add chrono --target rust
--       sky run src/Main.sky --target rust

import Rust.Chrono as Chrono
import Std.Log exposing (println)

main =
    case Chrono.now_from_utc () of
        Err _ ->
            println "Failed to get time"
        Ok now ->
            case Chrono.to_string_from_dateTime now of
                Err _ ->
                    println "Failed to format time"
                Ok formatted ->
                    println ("Current UTC date/time: " ++ formatted)
