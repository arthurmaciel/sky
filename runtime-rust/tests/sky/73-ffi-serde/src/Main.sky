module Main exposing (main)

-- 73-ffi-serde: Sky #47(a) — serde-bound generic methods (T: Serialize/DeserializeOwned).
--
-- P3 assertions: put/roundtrip/get_one are bound and callable; by_ref/pair/map_val
-- are absent (C-G3); own_serde is absent (C-G1).
--
-- DEFECT-2: a serde-bound generic RETURN on a METHOD (`Doc::get<T: DeserializeOwned>
-- (&self) -> T`, the firestore `DocumentReference::get` shape) and on a STATIC fn
-- (`Doc::load<T: DeserializeOwned>() -> T`) now BIND (inspector routes a serde-
-- reducible inherent method through the serde reduction) and the codegen emits the
-- `::<serde_json::Value>` turbofish on the method + static call sites. Pre-fix the
-- turbofish was only on the FREE-fn branch → the method/static calls had an
-- unconstrained `T` → cargo E0283.
--
-- Expected output:
--   [ALL OK]

import Rust.Serde_fixture exposing (put, roundtrip, get_one, new_from_doc, get_from_doc, load_from_doc)
import Sky.Core.Result as Result
import Std.Log exposing (println)


main =
    let
        -- put<T: Serialize>(x: T) -> String: pass a JSON array, get back
        -- serde_json::to_string of the Value, then its .len() as a string.
        putResult =
            put "[1,2,3]"

        -- roundtrip<T: Serialize + DeserializeOwned>(x: T) -> T: JSON round-trip
        rtResult =
            roundtrip "{\"key\":\"val\"}"

        -- get_one<T: DeserializeOwned>() -> T: produces a JSON-encoded value
        goResult =
            get_one ()

        -- DEFECT-2 method: Doc::get<T: DeserializeOwned>(&self) -> T over a Doc.
        -- Returns serde_json::to_string of the deserialised Value → "42".
        getResult =
            new_from_doc ()
                |> Result.andThen get_from_doc

        -- DEFECT-2 static: Doc::load<T: DeserializeOwned>() -> T.
        -- Returns serde_json::to_string of "loaded" → "\"loaded\"".
        loadResult =
            load_from_doc ()

        -- Verify all five succeeded
        ok =
            case putResult of
                Err _ -> False
                Ok putStr ->
                    case rtResult of
                        Err _ -> False
                        Ok rtStr ->
                            case goResult of
                                Err _ -> False
                                Ok _ ->
                                    case getResult of
                                        Err _ -> False
                                        Ok getStr ->
                                            case loadResult of
                                                Err _ -> False
                                                Ok loadStr ->
                                                    -- put: "[1,2,3]" → 7 chars → "7"
                                                    putStr == "7"
                                                        -- roundtrip: non-empty re-serialised JSON
                                                        && (String.length rtStr > 0)
                                                        -- Doc::get → serialised "42"
                                                        && getStr == "42"
                                                        -- Doc::load → serialised "loaded" (quoted)
                                                        && loadStr == "\"loaded\""
    in
    if ok then
        println "[ALL OK]"
    else
        println "[FAIL] serde-bound calls returned unexpected results"
