module Main exposing (main)

-- 82-ffi-async-trait: Sky WALL 4 (#64) — recognise the `#[async_trait]` PROC-MACRO
-- desugar and route it through the existing #44 async→Task machinery (the
-- keystone that unblocks firestore CRUD).
--
-- The macro rewrites `async fn m(..) -> T` into a PLAIN (non-async)
-- `fn m(..) -> Pin<Box<dyn Future<Output = T> + Send + 'async_trait>>`. The
-- inspector must recognise that box, extract Output=T, force is_async, and let T
-- flow through the existing async→Task path EXACTLY like a native `async fn`.
--
-- POSITIVE (bind + run end-to-end as Task):
--   Db.new ()             -- inherent ctor → opaque Db
--   op_from_db db x       -- #[async_trait] method → Task Error Int
--   put_from_db db json   -- COMPOSES: async-trait desugar + #65 serde-&I INPUT
--
-- NEGATIVE (must be ABSENT from bindings — coverage-dropped, never referenced):
--   non_future -- Pin<Box<dyn SomeOtherTrait + Send>>  (non-Future dyn → DROP)
--   not_send   -- Pin<Box<dyn Future<Output=i64>>>     (no +Send → DROP)

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Error as Error
import Sky.Core.Json.Encode as Encode
import Rust.Asynctraitcrate82 as Repo
import Std.Log exposing (println)


-- Build a JSON object via the typed encoder (no raw string literal): the Sky
-- JSON String the runtime deserialises to serde_json::Value at the boundary.
payload : String
payload =
    Encode.encode 0
        (Encode.object
            [ ( "name", Encode.string "sky" )
            , ( "version", Encode.int 82 )
            ]
        )


-- POSITIVE: the async-trait keystone round-trip.
--   op          : Db -> String -> Task Error Int   (#[async_trait] desugar)
--   put_from_db : Db -> String -> Task Error ()    (async-trait + #65 serde-&I)
checkRoundTrip : Task Error ()
checkRoundTrip =
    case Repo.new_from_db () of
        Err _ ->
            Task.fail (Error.unexpected "Db.new failed")

        Ok db ->
            -- 1. op: pass a 5-char String; the host returns its length (5) as Int.
            --    Receiver is arg0 (Db -> String), so the Db comes first.
            Repo.op db "hello"
                |> Task.andThen
                    (\n ->
                        if n == 5 then
                            -- 2. put: COMPOSES the async-trait desugar with the
                            --    #65 serde-&I INPUT (Sky JSON String → &Value).
                            Repo.put_from_db db payload
                                |> Task.andThen
                                    (\_ ->
                                        println "[ALL OK]"
                                    )

                        else
                            Task.fail (Error.unexpected ("op UNEXPECTED result: " ++ String.fromInt n))
                    )


main : Task Error ()
main =
    checkRoundTrip
