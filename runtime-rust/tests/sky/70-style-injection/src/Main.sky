module Main exposing (main)

-- Regression (P0): Std.Ui style markers (pseudo-class / media-query) must be
-- consumed into sky-id-scoped <style> blocks on the Rust backend (Go parity:
-- applyStyleInjections). Before batch 3 the markers rendered inert → zero CSS.
-- Also proves the </style> close-tag strip neutralises a breakout injected via
-- a raw media-query string (security).
import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Std.Live as Live
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.Ui as Ui
import Std.Ui.Background as Background
import Sky.Core.Error exposing (Error)

type Msg
    = Noop

type Page
    = Home

type alias Model =
    {  }


init : () -> ( Model, Cmd Msg )
init _ =
    ( {}, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update _ model =
    ( model, Cmd.none )


view _ =
    Ui.layout
        []
        (Ui.column
            []
            [ Ui.el
                  [ Background.color (Ui.rgb 200 200 200)
                  , Background.hoverColor (Ui.rgb 50 50 200)
                  ]
                  (Ui.text "hover me")
            , Ui.breakpoint
                  Ui.mobile
                  [Background.color (Ui.rgb 18 18 24)]
                  (Ui.text "responsive")
            , Ui.mediaQuery
                  "(min-width: 1px) </style><script>alert(1)</script>"
                  [Background.color (Ui.rgb 1 2 3)]
                  (Ui.text "breakout probe")
            ])


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


main =
    Live.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , routes = [Live.route "/" Home]
        , notFound = Home
        }
