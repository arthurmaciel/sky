module Main exposing (main)

-- MAIN-FUNCTIONALITY shim-free: url parse+scheme, chrono calendar-date ctor,
-- time from-unix-timestamp — real values, real APIs, no wrappers.
import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Error as Error
import Rust.Url as Url
import Rust.Chrono as Chrono
import Rust.Time as Time
import Std.Log exposing (println)


check : Task Error ()
check =
    case Url.parse_from_url "https://example.com/p" of

        Ok u ->
            case Url.scheme_from_url u of

                Ok scheme ->
                    case ( Chrono.from_ymd_from_naiveDate 2026 6 27
                         , Time.from_unix_timestamp_from_offsetDateTime 0
                         ) of

                        ( Ok _, Ok _ ) ->
                            if scheme == "https" then
                                Task.succeed ()

                            else
                                Task.fail
                                    (Error.unexpected ("scheme=" ++ scheme))

                        _ ->
                            Task.fail
                                (Error.unexpected "chrono/time ctor failed")

                Err e ->
                    Task.fail e

        Err _ ->
            Task.fail (Error.unexpected "url parse failed")


main : Task Error ()
main =
    check |> Task.andThen (\_ -> println "[ALL OK]")
