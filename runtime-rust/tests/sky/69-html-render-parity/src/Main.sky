module Main exposing (main)

-- Regression: render_html (Sky.Live/Tui/Webview path) Go-parity for four cases
-- closed in batch 2:
--   * <select value="b"> flips selected onto the matching <option> (not the first)
--   * <script>/<style> text children emit VERBATIM (inline JS/CSS not entity-escaped)
--   * ordinary text content is STILL entity-escaped ("Std.Ui escapes everything")
--   * Html.doctype renders a literal <!DOCTYPE html>
import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Std.Html as Html
import Std.Html.Attributes as Attr
import Std.Live as Live
import Std.Cmd as Cmd
import Std.Sub as Sub
import Sky.Core.Error exposing (Error)

type Msg
    = Noop

type Page
    = Home

type alias Model =
    {  }


init : () -> ( Model, Cmd Msg )
init _ =
    ( {}, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update _ model =
    ( model, Cmd.none )


view : Model -> Html.Html Msg
view _ =
    Html.div
        []
        [ Html.select
              [Attr.value "b"]
              [ Html.option [Attr.value "a"] [Html.text "A"]
              , Html.option [Attr.value "b"] [Html.text "B"]
              , Html.option [Attr.value "c"] [Html.text "C"]
              ]
        , Html.script [] [Html.text "if (1 < 2) { x = '&'; }"]
        , Html.div [] [Html.text "<b>raw</b>"]
        ]


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


main =
    Live.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , routes = [Live.route "/" Home]
        , notFound = Home
        }
