module Main exposing (main)

-- 74-ffi-opaque-client: Sky #52 — opaque-handle threading + concrete-impl
-- monomorphization. A realistic async-generic op over an OPAQUE, NOT-Clone
-- client handle binds shim-free (the firestore/stripe shape).
--
-- POSITIVE (bind + run end-to-end):
--   db  = O.db_new "u"                 -- opaque Db handle, returned by value
--   req = O.req_new () |> O.with_field "hi"
--   O.send req db |> Task.run          -- C: Wire monomorphizes to Db; Db threads
--                                      --   by-value as &C; Wire: Send admits it.
-- Asserts the result is "sent hi via db", then prints [ALL OK].
--
-- NEGATIVE (must be ABSENT from the bindings — coverage-dropped):
--   send_ambiguous  -- C: Transport has TWO impls (Db, Db2) → ambiguous → DROP
--   recv            -- C: Held over NotSend (Rc) → async future !Send → DROP
--
-- DEFECT-1 — async SELF-RECEIVER Send proof:
--   pong  -- SendClient::pong(&self) async; SendClient is Send (rustdoc synthetic
--            positive) → BINDS. Captures the receiver by-move into the async future
--            soundly. Exercised end-to-end below.
--   ping  -- RcClient::ping(&self) async on a Clone + !Send (Rc) receiver → the
--            receiver is captured by-move → !Send future → E0277 if bound. The
--            receiver Send-proof DROPS it (`async-future-not-send`). Must be ABSENT.
--            Pre-fix it BOUND and cargo-failed (the self-receiver Send hole).

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Error as Error
import Rust.Opaqueffi74 as O
import Std.Log exposing (println)


-- The opaque Db handle threads by value into the async generic op. The opaque
-- ctors / builder bind SYNC (`Result Error <opaque>`); bridge them into the
-- async pipeline with `Task.fromResult`.
checkSend : Task Error ()
checkSend =
    case ( O.new_from_db "u", O.new_from_req () ) of
        ( Ok db, Ok req0 ) ->
            case O.with_field_from_req req0 "hi" of
                Ok req ->
                    O.send_from_req req db
                        |> Task.andThen
                            (\s ->
                                if s == "sent hi via db" then
                                    println "send=sent hi via db"

                                else
                                    Task.fail (Error.unexpected ("send=UNEXPECTED " ++ s))
                            )

                Err e ->
                    Task.fail e

        _ ->
            Task.fail (Error.unexpected "opaque ctor failed")


-- DEFECT-1 positive: an async instance method on a PROVABLY-Send receiver still
-- binds and runs. `SendClient::pong(&self) -> Result<i64, String>` over a Send
-- receiver → the async wrapper captures it by-move soundly. `new 7` → pong → 8.
checkPong : Task Error ()
checkPong =
    case O.new_from_sendClient 7 of
        Ok sc ->
            O.pong_from_sendClient sc
                |> Task.andThen
                    (\n ->
                        if n == 8 then
                            println "pong=8"

                        else
                            Task.fail (Error.unexpected ("pong=UNEXPECTED " ++ String.fromInt n))
                    )

        Err e ->
            Task.fail e


-- DEFECT-3 positive: a SYNC generic method on a provably-Wire receiver (Db)
-- still binds and runs. `tag req db` → "tag hi". Sync, `Result Error String`.
checkTag : Task Error ()
checkTag =
    case ( O.new_from_db "u", O.new_from_req () ) of
        ( Ok db, Ok req0 ) ->
            case O.with_field_from_req req0 "hi" of
                Ok req ->
                    case O.tag_from_req req db of
                        Ok s ->
                            if s == "tag hi" then
                                println "tag=tag hi"

                            else
                                Task.fail (Error.unexpected ("tag=UNEXPECTED " ++ s))

                        Err e ->
                            Task.fail e

                Err e ->
                    Task.fail e

        _ ->
            Task.fail (Error.unexpected "opaque ctor failed for tag")


main : Task Error ()
main =
    checkSend
        |> Task.andThen (\_ -> checkPong)
        |> Task.andThen (\_ -> checkTag)
        |> Task.andThen (\_ -> println "[ALL OK]")
