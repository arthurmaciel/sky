module Main exposing (main)

-- 71-style-merge — Rust-backend regression for the inline-`style` merge bug.
--
-- Std.Ui composes each element's layout attrs (padding/background/border) into
-- ONE computed inline `style="…"`. A user `Ui.htmlAttribute "style" "z-index: 5"`
-- adds a SECOND `style`. The Rust render_html MUST merge both into a single
-- `style="…computed…; z-index: 5"` (Go parity, runtime-go/rt/live.go ~L176).
-- Pre-fix the Rust path emitted two `style="…"` attributes → the browser keeps
-- only the first → the user's `z-index: 5` was silently dropped.
--
-- The authoritative proof is the html.rs unit test
-- `style_attrs_merge_into_one_attribute`; this fixture is the end-to-end Sky
-- source that drives the same path through Std.Ui → renderElement → render_html.

import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Std.Html as Html
import Std.Live as Live
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.Ui as Ui
import Std.Ui.Background as Background


type Msg
    = Noop


type alias Model =
    { count : Int }


init : () -> ( Model, Cmd Msg )
init _ =
    ( { count = 0 }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update _ model =
    ( model, Cmd.none )


view : Model -> Html.Html Msg
view model =
    Ui.layout []
        (Ui.el
            -- Computed style (padding + background) AND a user style on the
            -- SAME element — the merge case under test.
            [ Ui.padding 8
            , Background.color (Ui.rgb 255 102 0)
            , Ui.htmlAttribute "style" "z-index: 5"
            ]
            (Ui.text ("Count: " ++ String.fromInt model.count))
        )


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


main : Task Error ()
main =
    Live.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , routes = [ Live.route "/" () ]
        , notFound = ()
        }
