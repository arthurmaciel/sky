module Main exposing (main)

-- MAIN-FUNCTIONALITY shim-free proof: hex (real bytes→hex encode, value-checked).
import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Error as Error
import Rust.Hex as Hex
import Std.Log exposing (println)


check : Task Error ()
check =
    case Hex.encode [ 104, 105 ] of

        Ok s ->
            if s == "6869" then
                Task.succeed ()

            else
                Task.fail (Error.unexpected ("hex.encode=UNEXPECTED " ++ s))

        Err e ->
            Task.fail e


main : Task Error ()
main =
    check |> Task.andThen (\_ -> println "[ALL OK]")
