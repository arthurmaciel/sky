module Main exposing (main)

-- 64-log-with-attrs: Std.Log.*With attr flattening, Go-parity.
--
-- Go's renderLogMsgWithAttrs flattens (msg, [a1, a2, …]) into a single line:
-- `msg a1 a2 …` (each ai via %v, space-joined). The Rust runtime mirrors this
-- via the SkyStringify-bounded log_*_with (NOT Display — tuples don't impl it).
--
-- Flat List String : "step done" + " ok" + " 200"      -> "step done ok 200"
-- List (String,String) tuple : %v of a Sky tuple is `{k v}`               .
--
-- Run:  sky run src/Main.sky --backend rust   (SKY_LOG_LEVEL=info default)
-- Expected stderr/stdout INFO lines carry the flattened attrs.

import Sky.Core.Prelude exposing (..)
import Std.Log as Log


main : Task Error ()
main =
    let
        _ =
            Log.infoWith "flat" [ "ok", "200" ]

        _ =
            Log.infoWith "tuple" [ ( "errId", "abc" ), ( "code", "42" ) ]
    in
    Log.println "done"
