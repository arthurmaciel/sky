module Main exposing (main)

-- 38-tui-ui — Sky.Tui with a Std.Ui Element view, on the Rust backend.
--
-- Fork-local proof for the Rust `Tui.app` → `tui_app_ui` path: the view is a
-- typed Std.Ui Element tree, wrapped in `Ui.layout` so it lowers to the same
-- `Html` tree Sky.Live renders. The Rust Tui driver (`tui::render::render_element`)
-- lays that Html out to ANSI cells. Wrapping in `Ui.layout` (rather than relying
-- on Go's internal-layout convention for a bare Element) keeps the Std.Ui render
-- chain reachable from Sky source, so whole-program DCE doesn't prune it.

import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Sky.Core.System as System
import Sky.Core.Task as Task
import Std.Tui as Tui
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.Html as Html
import Std.Ui as Ui
import Std.Ui.Background as Background
import Std.Ui.Font as Font


type alias Model =
    { running : Bool
    , elapsedMs : Int
    }


type alias KeyEvent =
    { kind : String
    , value : String
    }


type Msg
    = Tick
    | Toggle
    | Reset
    | Quit
    | NoOp


init : () -> ( Model, Cmd Msg )
init _ =
    ( { running = True, elapsedMs = 0 }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        Tick ->
            if model.running then
                ( { model | elapsedMs = model.elapsedMs + 100 }, Cmd.none )

            else
                ( model, Cmd.none )

        Toggle ->
            ( { model | running = not model.running }, Cmd.none )

        Reset ->
            ( { running = False, elapsedMs = 0 }, Cmd.none )

        Quit ->
            ( model, Cmd.perform (System.exit 0) (\_ -> NoOp) )

        NoOp ->
            ( model, Cmd.none )


view : Model -> Html.Html Msg
view model =
    Ui.layout []
        (Ui.column
            [ Ui.padding 32
            , Ui.spacing 16
            , Background.color (Ui.rgb 24 28 48)
            , Font.color (Ui.rgb 220 220 230)
            ]
            [ Ui.el [ Font.color (Ui.rgb 142 200 168) ]
                (Ui.text "Sky TUI (Rust) — Std.Ui Element view")
            , Ui.el [ Font.color (Ui.rgb 220 220 230) ]
                (Ui.text (formatElapsed model.elapsedMs))
            , Ui.el [ Font.color (Ui.rgb 150 150 170) ]
                (Ui.text (statusLine model))
            , Ui.el [ Font.color (Ui.rgb 120 120 140) ]
                (Ui.text "space pause/resume · r reset · q quit")
            ]
        )


statusLine : Model -> String
statusLine model =
    if model.running then "[ running ]" else "[ paused  ]"


formatElapsed : Int -> String
formatElapsed totalMs =
    let
        totalSec = totalMs // 1000
        minutes = totalSec // 60
        seconds = modBy 60 totalSec
        deciSec = modBy 10 (totalMs // 100)
    in
        pad2 minutes ++ ":" ++ pad2 seconds ++ "." ++ String.fromInt deciSec


pad2 : Int -> String
pad2 n =
    let s = String.fromInt n
    in
        if String.length s < 2 then "0" ++ s else s


onKey : KeyEvent -> Msg
onKey k =
    if k.kind == "space" then
        Toggle

    else if k.kind == "char" && k.value == "r" then
        Reset

    else if k.kind == "char" && k.value == "q" then
        Quit

    else if k.kind == "ctrl" && k.value == "c" then
        Quit

    else
        NoOp


subscriptions : Model -> Sub Msg
subscriptions model =
    if model.running then
        Sub.every 100 Tick

    else
        Sub.none


main =
    Tui.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , onKey = onKey
        }
        |> Task.run
