module Lib.Auth exposing (verifyToken, signOut, getUserById, isAdmin, getSessionUser)

import Sky.Core.Prelude exposing (..)
import Sky.Core.Maybe exposing (..)
import Sky.Core.Result as Result
import Sky.Core.Task as Task
import Sky.Core.List as List
import Sky.Core.Dict as Dict
import Sky.Core.String as String
import Std.Log exposing (println)
import System
import Lib.Db as Db
import Sky.Core.Error as Error exposing (Error(..), ErrorKind(..))
import Rust.Sky_firebase_auth_shim as FirebaseAuth


adminEmails _ =
    let
        envAdmins =
            Result.withDefault "" (Task.run (System.getenv "ADMIN_EMAILS"))
    in
        if envAdmins == "" then
            ["admin@example.com"]

        else
            String.split "," envAdmins


isAdmin : Dict String String -> Bool
isAdmin user =
    Db.getBool "is_admin" user


-- ══════════════════════════════════════════════════════
-- VERIFY TOKEN (over Rust.Sky_firebase_auth_shim)
-- ══════════════════════════════════════════════════════
-- The shim returns a flat row { uid, email, name } on success. The error-slot
-- wrinkle: we discard the Err payload (`Err _ ->`) and surface a typed Error.
verifyToken idToken =
    case FirebaseAuth.fb_verify_id_token idToken of

        Ok identity ->
            let
                uid = Db.getField "uid" identity
                email = Db.getField "email" identity
                name = Db.getField "name" identity
                _ =
                    println
                        ("[AUTH] Firebase token verified for: " ++ email
                            ++ " (uid: "
                            ++ uid
                            ++ ")")
            in
                findOrCreateUser uid email name

        Err _ ->
            let
                _ = println "[AUTH] Firebase token verification failed"
            in
                Err
                    (Error.permissionDenied
                        |> Error.withMessage
                               "Authentication failed. Please try again.")


findOrCreateUser uid email name =
    let
        isAdminUser = List.member email (adminEmails ())
        adminStr =
            if isAdminUser then
                "true"

            else
                "false"
        upsertData =
            Dict.fromList
                [ ( "id", uid )
                , ( "firebase_uid", uid )
                , ( "email", email )
                , ( "name", name )
                , ( "is_admin", Db.boolVal isAdminUser )
                ]
        _ = Db.setDoc "users" uid upsertData
        result = Db.getDoc "users" uid
    in
        case result of

            Ok maybeUser ->
                case maybeUser of

                    Just user ->
                        if Db.getBool "suspended" user then
                            Err
                                (Error.permissionDenied
                                    |> Error.withMessage
                                           "Account suspended. Please contact support.")

                        else
                            let
                                _ =
                                    println
                                        ("[AUTH] Signed in: " ++ email
                                            ++ " (admin: "
                                            ++ adminStr
                                            ++ ")")
                                -- setDoc returns the doc id only (not the stored
                                -- row), so the upsert fields are the canonical
                                -- identity — return them directly (also avoids
                                -- Dict.union, not yet on the Rust runtime).
                            in
                                Ok upsertData

                    Nothing ->
                        Ok upsertData

            Err _ ->
                Ok upsertData


signOut =
    let
        _ = println "[AUTH] User signed out"
    in
        ()


getUserById userId =
    Db.getDoc "users" userId


getSessionUser userId =
    case getUserById userId of

        Ok maybeUser ->
            maybeUser

        Err _ ->
            Nothing
