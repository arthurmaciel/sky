module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import Sky.Core.Io as Io
import Std.Ui as Ui
import Std.Html as Html


main =
    Io.writeStdout (Html.toString (Ui.layout [] view))


view : Ui.Element ()
view =
    Ui.column [ Ui.spacing 12, Ui.padding 16 ]
        [ Ui.row [ Ui.spacing 8, Ui.centerX ]
            [ Ui.text "a", Ui.text "b" ]
        , Ui.el [ Ui.alignRight ] (Ui.text "c")
        ]
